---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import '../assets/scss/components/figcaption.scss'

interface Props {
  src: string
  alt: string
  width: number
  height: number
  asVideo?: boolean,
  metadata: ImageMetadata
}

const {asVideo, ...props} = Astro.props
---

<figure class="blog-figure">
  <figcaption>
    <span>
      <slot />
      {!asVideo && (
        <Icon name="picture-in-picture" class="picture-in-picture" width={18} height={18} />
      )}
    </span>
  </figcaption>
  
  {
    asVideo ? (
      <video muted playsinline controls>
        <source {...props}  type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    ) : <Image {...props} class="" />
  }
</figure>
