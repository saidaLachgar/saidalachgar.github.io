---
import { Picture } from 'astro:assets'
import img from '../assets/img/senior-frontend-developer-portfolio.png'
---
<div data-reveal>
  <Picture
    widths={[300, 600, 800, 1000, 1728]}
    sizes="100vw"
    src={img}
    alt="saida's portfolio - developer"
    formats={['avif', 'webp']}
    loading="eager"
  />
</div>

<style lang="scss">
  img {
    width: 100%;
    height: auto;
  }
</style>
