---
import { Icon } from 'astro-icon/components'
import SkipToContent from '../components/SkipToContent.astro'
import TimeComponent from './TimeComponent.astro'
import { PERSON } from '@/consts'
---

<header>
  <SkipToContent />
  <div class="menu container">
    <div class="logo">
      <a href="/" data-astro-prefetch="load" aria-label="Saida lachgar"><Icon name="logo" width={87} height={87} /></a>
    </div>

    <nav class="navigation" aria-label="Main navigation desktop">
      <ul>
        <li class="menu-item">
          <a href="/#projects" data-label="adventures">projects</a>
        </li>
        <li class="menu-item">
          <a href="/#services" data-label="magic">services</a>
        </li>
        <li class="menu-item">
          <a href="/#playground" data-label="experiment">playground</a>
        </li>
        <li class="menu-item">
          <a href="/#about" data-label="identity">about</a>
        </li>
        <li class="menu-item">
          <a href="/#blog" data-label="thoughts">journal</a>
        </li>
      </ul>
    </nav>

    <div class="info">
      <ul class="coordinate">
        <li>
          <button
            id="book-a-call"
            data-cal-namespace="15min"
            data-cal-config='{"layout":"month_view"}'
            data-cal-link="saidalachgar/15min">Let's Collaborate – Book a Call</button
          >
        </li>
        <li><p>{PERSON.location} <TimeComponent /></p></li>
      </ul>
      <ul class="contact">
        <li><a href={`mailto:${PERSON.mail}`} target="_self">{PERSON.mail}</a><i/></li>
        <li><a href={`sms:${PERSON.sms_link}`} target="_self">text {PERSON.sms}</a><i/></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const contactLinks: NodeListOf<HTMLAnchorElement> = document.querySelectorAll('header .contact a')
  contactLinks.forEach(contact => {
    const mailLink = contact.href.replace('mailto:', '').replace('sms:', '')
    const copyMessage = contact.nextElementSibling as HTMLElement | null
    contact.addEventListener('click', (e) => {
      e.preventDefault();
      if (!navigator.clipboard || !copyMessage) {
        return
      }
      navigator.clipboard.writeText(mailLink).then(
        () => {
          copyMessage.textContent = '(copied!)'
        },
        () => {
          copyMessage.title = '( sorry copying to clipboard failed )'
        }
      )
      setTimeout(() => {
        copyMessage.title = ''
        copyMessage.textContent = ''
      }, 2000)
    })
  });
</script>

<!-- Cal element-click embed — loaded lazily on first interaction -->
<script>
  function initCal() {
    if ((window as any)._calLoaded) return
    ;(window as any)._calLoaded = true
    ;(function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => { a.q.push(ar) }
      const d = C.document
      C.Cal = C.Cal || function (...args: any[]) {
        const cal = C.Cal
        if (!cal.loaded) {
          cal.ns = {}; cal.q = cal.q || []
          d.head.appendChild(d.createElement('script')).src = A
          cal.loaded = true
        }
        if (args[0] === L) {
          const api: any = (...a: any[]) => p(api, a)
          const ns = args[1]
          api.q = api.q || []
          if (typeof ns === 'string') {
            cal.ns[ns] = cal.ns[ns] || api
            p(cal.ns[ns], args)
            p(cal, ['initNamespace', ns])
          } else p(cal, args)
          return
        }
        p(cal, args)
      }
    })(window, 'https://app.cal.com/embed/embed.js', 'init')
    const Cal = (window as any).Cal
    Cal('init', '15min', { origin: 'https://cal.com' })
    Cal.ns['15min']('ui', {
      theme: 'dark',
      styles: { branding: { brandColor: '#000000' } },
      hideEventTypeDetails: true,
      layout: 'month_view',
    })
  }

  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('book-a-call')
    if (!btn) return
    btn.addEventListener('mouseenter', initCal, { once: true })
    btn.addEventListener('focus', initCal, { once: true })
    // Ensure Cal is ready before click fires the embed
    btn.addEventListener('click', () => { if (!(window as any)._calLoaded) initCal() })
  })
</script>

<style lang="scss">
  header {
    top: 0;
    padding-top: var(--default-space);
    position: sticky;
    text-transform: lowercase;
    z-index: 1000;
    .navigation ul {
      width: max-content;
      li {
        opacity: 0;
        animation: reveal 1.6s cubic-bezier(0.77, 0, 0.175, 1) 0s forwards;
        &:nth-child(2) {
          animation-delay: 0.3s;
        }
        &:nth-child(3) {
          animation-delay: 0.5s;
        }
        &:nth-child(4) {
          animation-delay: 0.7s;
        }
        &:nth-child(5) {
          animation-delay: 0.9s;
        }
      }
      a {
        transition: all 0.6s ease;
        display: block;
        position: relative;
        overflow: hidden;
        height: 17px;
        width: max-content;
        &::before {
          content: attr(data-label);
          display: block;
          padding-right: 15px;
          transition: margin-top 0.6s ease;
          margin-top: -17px;
          background: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='9' height='9' fill='none' viewBox='0 0 9 9'%3e%3cpath fill='%23fff' d='m9 4.608-.75-.732L5.03 7.02V0H3.97v7.02L.752 3.876 0 4.608 4.5 9 9 4.608Z'%3e%3c/path%3e%3c/svg%3e")
            center right no-repeat;
        }
      }
      &:hover a {
        opacity: 0.5;
      }
      a:hover {
        opacity: 1;
        &::before {
          margin-top: 0;
        }
      }
    }
    .contact li {
      opacity: 0;
      animation: reveal 1.6s cubic-bezier(0.77, 0, 0.175, 1) 0.7s forwards;
      &:nth-child(2) {
        animation-delay: .9s;
      }
    }
    .coordinate button,
    .contact a {
      transition: transform 0.6s ease;
      display: inline-block;
      background-color: transparent;
      color: #fff;
      font-family: inherit;
      &:hover {
        transform: translateX(5px);
      }
    }
    .coordinate li {
      opacity: 0;
      animation: reveal 1.6s cubic-bezier(0.77, 0, 0.175, 1) 0.3s forwards;
      &:nth-child(2) {
        animation-delay: 0.5s;
      }
    }
    .menu {
      display: flex;
      justify-content: space-between;
    }
    .logo {
      width: 70%;
      opacity: 0;
      animation: reveal 1.6s cubic-bezier(0.77, 0, 0.175, 1) 0s forwards;
      svg {
        animation: rotating 50s linear infinite;
      }
    }
    .info {
      min-width: 160px;
      width: auto;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .navigation {
      flex: 1;
      min-width: 100px;
    }
    .contact{
      i{
        position: absolute;
        white-space: nowrap;
        font-size: 10px;
        margin-top: 2px;
        margin-left: 10px;
      }
    }
    @media (max-width: 655px) {
    position: static !important;
      .logo {
        width: 100%;
        svg {
          margin-left: auto;
          height: 90px;
          width: auto;
        }
      }
      .info {
        display: none;
      }
    }
  }
  header {
    &,
    .logo {
      pointer-events: none;
    }
    .navigation,
    .info,
    .logo a,
    .skip-links {
      pointer-events: all;
    }
  }
</style>

<script>
  const title = document.title
  let interval: NodeJS.Timeout
  // Event listener for visibility change
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) {
      setTimeout(() => {
        if (document.hidden) {
          // Function to update tab title with ellipsis animation
          let ellipsisCount = 1
          interval = setInterval(function () {
            const ellipsis = 'Zzzz' + '.'.repeat(ellipsisCount - 1)
            document.title = ellipsis
            ellipsisCount = (ellipsisCount % 3) + 1 // Loop between 1, 2, 3
          }, 1000) // Adjust the interval as needed
        }
      }, 60000)
    } else {
      // Page is visible again, revert to default favicon
      clearInterval(interval)
      document.title = 'Welcome Back, Explorer!'
      setTimeout(() => {
        setTimeout(() => (document.title = title), 1000)
      }, 1000)
    }
  })
</script>
