---
import Link from './Link.astro'
import { type CollectionEntry, getEntry } from 'astro:content'

interface Props {
  count?: number,
  tag?: CollectionEntry<'tags'>
  id?: string
}

let tag = Astro.props.tag

if (!tag && Astro.props.id) {
  tag = (await getEntry('tags', Astro.props.id)) as CollectionEntry<'tags'>
}

const { count = 0 } = Astro.props;
---

<Link href={`/tags/${tag?.slug ?? ''}/`} class="tag">
  {tag?.data.name}{count ? ` (${count})` : ''}
</Link>

<style lang="scss">
  .tag {
    font-size: 12px;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.08);
    transition: background-color 0.3s ease-in;
    border-radius: 28px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
