---
import { playground, projects, projectStats, type Project } from '@/data/projects'
import { Icon } from 'astro-icon/components'
import WorkDetails from './WorkDetails.astro'

const years = projectStats.find(stat => stat.caption === 'Years')?.value || 'X';
---
<section class="work container" id="projects">
  <div class="header" data-reveal>
    <p class="subtitle">Area of Expertise</p>
    <h2 class="title">Selected <br />Work</h2>
    <p class="description">
      Over the past {years} years, I've had the privilege to work on so many cool projects, i’ve worked in areas including
      APIs and Integration, responsive web design, eCommerce, CMS, SEO... Here's a few.
    </p>
  </div>

  <div class="content">
    <ul>
      {
        projects.slice(0, 8).map((project: Project, key: number) => (
          <li data-reveal>
            <div class="project" data-target={`project-${key}`}>
              <p class="name">
                <span>
                  {project.name} - {project.platform}
                </span>
                <i />
              </p>
              <span class="role">{project.role}</span>
              <span class="year">{project.year}{project.present ? ' – Present' : ''}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <a href="/projects/" class="more" data-reveal data-astro-prefetch="viewport">
      <Icon name="arrow-top-right" width={15} height={15} />
      <u>See all projects</u>
      <sup>({projects.length + playground.length})</sup>
    </a>
  </div>
</section>

<WorkDetails data={[...projects.slice(0, 8), ...playground]} />

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // cursor
    const playgroundItems= document.querySelectorAll('.playground li')
    playgroundItems.forEach((container) => {
      const cursor = container.querySelector('.cursor')
      if (!cursor) return
      container.addEventListener('mousemove', ({ clientX, clientY }) => {
        const { left, top } = container.getBoundingClientRect()
        cursor.style.left = `${clientX - left}px`
        cursor.style.top = `${clientY - top}px`
      })
    })

    // carousel (scroll)
    const sticky = document.querySelector('.playground .carousel-outer')
    const stickyParent = document.querySelector('.playground .carousel-container')
    const carouselInner = document.querySelector('.playground .carousel-inner')
    if (sticky && stickyParent && carouselInner) {
      let scrollStart, scrollWidth, verticalScrollHeight

      const recalc = () => {
        const topOffset = window.innerHeight / 2 - 282
        // Compute the scroll position at which the sticky zone begins.
        // Using window.scrollY + getBoundingClientRect avoids stale values from
        // getBoundingClientRect alone during iOS Safari momentum scrolling.
        scrollStart = stickyParent.getBoundingClientRect().top + window.scrollY - topOffset
        scrollWidth = sticky.scrollWidth
        verticalScrollHeight = stickyParent.offsetHeight - sticky.offsetHeight
      }

      recalc()
      window.addEventListener('resize', recalc)

      document.addEventListener('scroll', () => {
        const scrolled = window.scrollY - scrollStart
        if (scrolled <= 0) {
          sticky.classList.remove('is-sticky')
          carouselInner.style.transform = 'translateX(0px)'
        } else {
          // Clamp so the inner never moves past the last slide (mirrors scrollLeft clamping).
          const maxTranslate = sticky.clientWidth - scrollWidth
          const translateX = Math.max(maxTranslate, -(scrollWidth / verticalScrollHeight) * scrolled * 0.5)
          carouselInner.style.transform = `translateX(${translateX}px)`
          sticky.classList.add('is-sticky')
        }
      })
    }
  })
</script>

<style lang="scss">
  .work {
    position: relative;
    padding-top: 50px;
    margin-top: 150px;
    z-index: 100;
    
    .content {
      max-width: 760px;
    }
    .subtitle {
      font-size: 11px;
    }
    .title {
      font-size: 64px;
      margin: 30px 0;
      font-family: var(--font-family-secondary);
    }
    .description {
      font-size: 13px;
      margin: 0 0 70px;
      max-width: 478px;
      p {
        margin-bottom: 6px;
      }
      b {
        font-weight: bold;
      }
    }
    .more {
      font-size: 18px;
      display: flex;
      column-gap: 7px;
      align-items: center;
      text-transform: uppercase;
      margin: 20px auto 0;
      width: max-content;
      cursor: pointer;
      sup {
        margin-top: -10px;
        font-size: 12px;
      }
      svg {
        margin-top: 2px;
      }
    }
    ul {
      max-height: 540px;
      overflow: hidden;
      position: relative;
      &::after {
        content: '';
        width: 100%;
        height: 100%;
        pointer-events: none;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.1) 100%);
        position: absolute;
        left: 0;
        top: 0;
        z-index: 1;
        transition: opacity 0.2s ease;
      }

      &:hover {
        &::after {
          transition-duration: 2s;
          opacity: 0;
        }
        li {
          opacity: 0.2;
          top: 0;
          scale: 1;
        }
      }
      li {
        transition: opacity 0.9s ease;
        &:hover {
          z-index: 2;
          position: relative;
          opacity: 1;
        }
      }
    }
    .project {
      display: grid;
      align-items: center;
      column-gap: 10px;
      cursor: pointer;
      padding: 20px 0;
      grid-template-columns: minmax(0, 1fr) repeat(2, auto);
    }
    .name {
      font-size: 18px;
      font-weight: 500;
      display: flex;
      align-items: center;
      column-gap: 10px;
      i {
        flex: 1;
        height: 1px;
        background-color: rgb(255, 255, 255, 0.1);
      }
    }

    .role {
      font-size: 13px;
    }
    .year {
      font-size: 11px;
    }
    @media (max-width: 655px) {
      margin-top: 60px;

      .title {
        margin: 10px 0;
        font-size: 35px;
      }

      .description {
        margin-bottom: 15px;
      }
    }
  }
</style>
