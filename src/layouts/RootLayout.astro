---
import '../assets/scss/globals.scss'
import type { CollectionEntry } from 'astro:content'
import SiteMeta from '../components/SiteMeta.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { useTranslations } from '@/i18n'

const t = useTranslations()

interface Props {
  title: string
  description: string
  titleTemplate?: string
  robots?: string
  primarySchema?: any
  secondarySchema?: any
  keywords?: string
  canonicalUrl?: string
  article?: {
    publishedTime: Date
    modifiedTime?: Date
    authors: string[]
    authorTwitter?: string
    tags: string[]
    cover: CollectionEntry<'blog'>['data']['cover']
  }
}
---

<html lang={t('siteMetadata.language')} dir="ltr">
  <SiteMeta {...Astro.props} />
  <body style="background-color: #000;">
    <div id="loader" style="display: none;"></div>
    <div id="main">
      <main id="main-content" transition:animate="fade">
        <Header />
        <slot />
        <i id="overlay" aria-hidden="true"></i>
      </main>
      <Footer />
    </div>

    <script>
      let loadingInterval: ReturnType<typeof setInterval> | undefined

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return
        const linkElement = event.target.closest('a')

        if (linkElement && !linkElement.hasAttribute('target')) {
          const href = linkElement.href
          const currentUrl = window.location.href

          const linkUrl = new URL(href, currentUrl)
          const currentPathname = window.location.pathname
          const linkPathname = linkUrl.pathname

          if (currentPathname === linkPathname && linkUrl.hash) {
            return
          }

          const loader = document.getElementById('loader')
          if (loader) {
            loader.style.display = 'flex'
            const mainEl = document.getElementById('main')
            if (mainEl) mainEl.style.display = 'none'

            const loadingMessages = [
              'Loading...',
              'Cargando...',
              'Chargement...',
              'Laden...',
              'Caricamento...',
              '読み込み中...',
              '로딩 중...',
              '加载中...',
              'Загрузка...',
              'Carregando...',
              'جار التحميل...',
              'लोड हो रहा है...',
            ]

            let currentGreeting = 0
            loadingInterval = setInterval(() => {
              loader.textContent = loadingMessages[currentGreeting]
              currentGreeting = (currentGreeting + 1) % loadingMessages.length
            }, 120)
          }
        }
      })

      document.addEventListener('astro:page-load', () => {
        clearInterval(loadingInterval)

        document.addEventListener('scroll', () => {
          const revealPoint = 200
          const revealElements = document.querySelectorAll('[data-reveal]')
          for (let i = 0; i < revealElements.length; i++) {
            const windowHeight = window.innerHeight
            const revealTop = revealElements[i].getBoundingClientRect().top
            if (revealTop < windowHeight - revealPoint) {
              revealElements[i].classList.add('active')
            } else {
              revealElements[i].classList.remove('active')
            }
          }
        })
      })
    </script>
  </body>
</html>
