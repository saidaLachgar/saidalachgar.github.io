---
import Stats from '@/components/Stats.astro'
import About from '../components/About.astro'
import Work from '../components/Work.astro'
import Hero from '../components/Hero.astro'
import Blog from '../components/Blog.astro'
import Services from '../components/Services.astro'
import Figure from '../components/Figure.astro'
import RootLayout from '@/layouts/RootLayout.astro'
import { useTranslations } from '@/i18n'
import { SITE_METADATA, PERSON } from '@/consts'
import Playground from '@/components/Playground.astro'

const t = useTranslations()

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Saida Lachgar's professional background?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Saida Lachgar is a Senior Frontend Developer based in Agadir, Morocco, with over ${PERSON.yearsOfExperience} years of professional experience building responsive, high-performance web applications across e-commerce, healthcare, tourism, and enterprise sectors.`
      }
    },
    {
      "@type": "Question",
      "name": "What technologies and frameworks does Saida specialize in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Saida specializes in React, TypeScript, Symfony, PrestaShop, and WordPress, with additional expertise in Three.js, GSAP animations, SEO optimization, and Core Web Vitals performance tuning."
      }
    },
    {
      "@type": "Question",
      "name": "What types of projects has Saida worked on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Saida has worked on custom e-commerce themes for PrestaShop and Sylius, full-stack Symfony applications including an electricity quality monitoring platform, healthcare systems, tourism websites, and interactive 3D web experiences using Three.js and GSAP."
      }
    },
    {
      "@type": "Question",
      "name": "How can I get in touch with Saida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `You can reach Saida via email at ${PERSON.mail}, connect on LinkedIn at ${PERSON.socials.linkedin}, or book a discovery call directly through the portfolio.`
      }
    }
  ]
};

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Saida Lachgar",
  "url": SITE_METADATA.siteUrl,
  "image": `${SITE_METADATA.siteUrl}profile-picture.png`,
  "jobTitle": ["Senior Frontend Developer", "Fullstack Developer", "React Developer", "Three.js Developer", "SEO Specialist"],
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": "Faculty of Science and Technology, Settat",
      "sameAs": "https://www.fsts.ac.ma"
    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Specialized Institute of Applied Technology, Agadir",
      "sameAs": "https://www.ofppt.ma/"
    }
  ],
  "email": `mailto:${PERSON.mail}`,
  "sameAs": [
    PERSON.socials.linkedin,
    PERSON.socials.dribbble,
  ],
  "knowsAbout": [
    "React",
    "TypeScript",
    "Symfony",
    "PrestaShop",
    "Three.js",
    "GSAP",
    "SEO Optimization",
    "Core Web Vitals",
    "Web Performance"
  ]
};
---

<RootLayout
  title={t('siteMetadata.title')}
  description={t('siteMetadata.description')}
  keywords="frontend developer Morocco, React developer, Symfony developer, PrestaShop developer, Three.js developer, web performance optimization, Core Web Vitals"
  primarySchema={profileSchema}
  secondarySchema={faqSchema}
>
  <Hero />
  <Work />
  <Figure />
  <Services />
  <Playground />
  <About />
  <Stats />
  <Blog />
</RootLayout>
